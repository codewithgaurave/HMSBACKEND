# Hospital Management System - Backend Environment Config Template
# Copy this file to .env and provide your actual secrets
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hospital_management_db?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=24h
CLIENT_URL=http://localhost:5173
HOSPITAL_NAME="Hospital Management System"
HOSPITAL_TIMEZONE="Asia/Kolkata"

# Email Configuration (for password reset and automated notifications)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@hospitalmanagement.com
FROM_NAME="Hospital Management System"
